# Base URL of the Enterprise AI Assistant backend.
# Leave empty in development: the Vite proxy forwards the API route
# prefixes (/auth /chat /conversations /documents /search /memories
# /approvals /health /metrics) to http://localhost:8000.
# Set to an absolute URL (e.g. https://api.example.com) in production.
VITE_API_BASE_URL=

# Dev proxy target (only used by vite.config.ts)
VITE_API_TARGET=http://localhost:8000