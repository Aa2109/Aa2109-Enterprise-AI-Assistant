

APP_NAME=Enterprise AI Assistant

ENVIRONMENT=development

DEBUG=true

HOST=0.0.0.0

PORT=8000

DATABASE_URL=

OPENAI_API_KEY=

GEMINI_API_KEY=

OPENROUTER_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OLLAMA_URL=

LLM_PROVIDER=gemini

LLM_MODEL=gemini-3.1-flash-lite

LLM_FALLBACK_PROVIDERS=openrouter
LLM_FALLBACK_MODEL=google/gemini-2.5-flash
LLM_MAX_TOKENS=4096

# Security
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000

QDRANT_URL=

REDIS_URL=

# --------------------------------------------------
# PR-28 Reliability — centralized timeouts (seconds)
# --------------------------------------------------
LLM_TIMEOUT_SECONDS=60
RAG_TIMEOUT_SECONDS=5
DATABASE_TIMEOUT_SECONDS=5
WEB_SEARCH_TIMEOUT_SECONDS=10
REDIS_TIMEOUT_SECONDS=2
AGENT_TOTAL_TIMEOUT_SECONDS=120

# HTTP client
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_WRITE_TIMEOUT_SECONDS=5
HTTP_POOL_TIMEOUT_SECONDS=5
HTTP_MAX_CONNECTIONS=50
HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# Retry policy
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=8

# Circuit breaker
CIRCUIT_FAIL_MAX=5
CIRCUIT_RECOVERY_TIMEOUT_SECONDS=30

# Agent safety limits
MAX_AGENT_STEPS=6
MAX_TOOL_CALLS=10
MAX_INPUT_TOKENS=12000
MAX_OUTPUT_TOKENS=3000
MAX_TOTAL_TOKENS=15000
MAX_CONTEXT_CHARS=30000
MAX_QUERY_ROWS=100

# Concurrency
AGENT_CONCURRENCY=3

# Response caching
REDIS_CACHE_TTL_SECONDS=300
KNOWLEDGE_VERSION=1
