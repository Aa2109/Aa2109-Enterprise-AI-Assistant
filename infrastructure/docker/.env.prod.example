# ==================================================================
# Copy to `.env.prod` (same directory) and fill in real values.
# `.env.prod` is gitignored — never commit real credentials.
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# ==================================================================

# Image identity (immutable tag from CI, e.g. git-a81f3c2)
IMAGE_TAG=1.0.0
BACKEND_PORT=8000

# --- Backend credentials -----------------------------------------
# postgresql://user:password@postgres:5432/enterprise_ai
DATABASE_URL=postgresql://enterprise:CHANGE_ME@postgres:5432/enterprise_ai
REDIS_URL=redis://redis:6379/0

# Auth / agent keys — rotate weekly, never share
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite

# --- Data stores -------------------------------------------------
POSTGRES_DB=enterprise_ai
POSTGRES_USER=enterprise
POSTGRES_PASSWORD=CHANGE_ME